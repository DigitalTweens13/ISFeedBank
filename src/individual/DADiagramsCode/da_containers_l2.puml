@startuml "da_containers_l2.puml"
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!include ../../main.puml

' Индивидуальная версия: DA, база данных и кэш. Глоссарий ID и правила: см. context_l1.puml тимлида

title Диаграмма контейнеров (L2) ИС управления обратной связью клиентов банка. Фокус: хранилища данных

Person($ID_CX_ANALYST, "Аналитик клиентского опыта", "Загружает отзывы, анализирует настроения клиентов, формирует отчёты")
Person($ID_PRODUCT_OWNER, "Владелец продукта", "Отвечает за обращения по своему продуктовому направлению: ипотека, карты, приложение, отделения")
Person($ID_HEAD_OF_DIRECTION, "Руководитель направления", "Контролирует сроки реакции на обращения, получает эскалации")
Person($ID_ADMIN, "Администратор системы", "Ведёт справочники тем, владельцев и нормативных сроков")

System_Ext($ID_REVIEW_SOURCE, "Источник отзывов", "Агрегатор отзывов о банках с программным интерфейсом выгрузки")
System_Ext($ID_LLM_SERVICE, "Сервис языковой модели", "Внешняя большая языковая модель для определения тем и тональности отзывов")
System_Ext($ID_NOTIFY_SERVICE, "Сервис уведомлений", "Почтовый сервер банка и push-сервисы APNs / FCM")
System_Ext($ID_REPORTING_SYSTEM, "Система отчётности банка", "Корпоративное хранилище управленческой отчётности")
System_Ext($ID_BANK_IAM, "Система управления доступом банка", "Единый вход и ролевая модель сотрудников банка")

System_Boundary($ID_FEEDBACK_SYSTEM, "ИС управления обратной связью клиентов банка") {
    Container($ID_WEB_PANEL, "Веб-панель", "React / TypeScript, SPA", "Дашборд настроений, реестры отзывов и обращений, справочники, отчёты")
    Container($ID_MOBILE_APP, "Мобильное приложение", "TypeScript / React Native, iOS / Android", "Обращения и эскалации для владельцев продуктов и руководителей, смена статусов вне рабочего места")
    Container($ID_API_BACKEND, "Backend API", "Python / FastAPI, JWT", "REST API, проверка доступа, статусная модель обращений, назначение владельцев, отчёты")
    Container($ID_LABELING_WORKER, "Воркер разметки", "Python / Celery", "Кластеризация, мультилейбл-классификация тем, определение тональности, заведение обращений при негативе")
    Container($ID_MESSAGE_BROKER, "Брокер сообщений", "RabbitMQ", "Очереди reviews.labeling (задачи разметки) и cases.events (события по обращениям)")
    Container($ID_BACKGROUND_WORKER, "Воркер фоновых задач", "Python / Celery beat", "Сбор отзывов по расписанию, контроль сроков, эскалации, рассылка уведомлений")
    ContainerDb($ID_DATABASE, "База данных", "PostgreSQL 16", "Отзывы, разметка, обращения, история статусов, справочники, витрины аналитики")
    ContainerDb($ID_CACHE, "Кэш", "Redis", "Предрассчитанные агрегаты дашборда")
}

' --- фокус ---
Rel($ID_API_BACKEND, $ID_DATABASE, "Сохраняет обращения, историю статусов, справочники и пакеты отзывов", "SQL / TCP")
Rel($ID_API_BACKEND, $ID_DATABASE, "Получает данные реестров и витрин аналитики", "SQL / TCP")
Rel($ID_API_BACKEND, $ID_CACHE, "Получает агрегаты дашборда, при промахе записывает их", "RESP / TCP")
Rel($ID_LABELING_WORKER, $ID_DATABASE, "Сохраняет темы и тональность отзывов", "SQL / TCP")
Rel($ID_LABELING_WORKER, $ID_DATABASE, "Заводит обращения при негативе", "SQL / TCP")
Rel($ID_BACKGROUND_WORKER, $ID_DATABASE, "Сохраняет отзывы, полученные из источника", "SQL / TCP")
Rel($ID_BACKGROUND_WORKER, $ID_DATABASE, "Выбирает обращения с истекающим сроком", "SQL / TCP")
Rel($ID_BACKGROUND_WORKER, $ID_DATABASE, "Фиксирует эскалацию просроченного обращения", "SQL / TCP")
Rel($ID_API_BACKEND, $ID_REPORTING_SYSTEM, "Выгружает отчёт, собранный из витрин", "HTTPS / REST, JSON")

' --- вне фокуса ---
Rel($ID_CX_ANALYST, $ID_WEB_PANEL, "Изучает дашборд и формирует отчёты", "HTTPS")
Rel($ID_ADMIN, $ID_WEB_PANEL, "Настраивает справочники", "HTTPS")
Rel($ID_PRODUCT_OWNER, $ID_WEB_PANEL, "Берёт обращения в работу", "HTTPS")
Rel($ID_PRODUCT_OWNER, $ID_MOBILE_APP, "Меняет статусы", "HTTPS")
Rel($ID_HEAD_OF_DIRECTION, $ID_MOBILE_APP, "Просматривает эскалации", "HTTPS")
Rel($ID_WEB_PANEL, $ID_API_BACKEND, "Запрашивает и изменяет отзывы, обращения и справочники", "HTTPS / JSON, REST")
Rel($ID_MOBILE_APP, $ID_API_BACKEND, "Передаёт смену статуса и запрашивает обращения", "HTTPS / JSON, REST")
Rel($ID_API_BACKEND, $ID_BANK_IAM, "Проверяет доступ сотрудников", "HTTPS / OAuth 2.0 (OIDC)")
Rel($ID_API_BACKEND, $ID_MESSAGE_BROKER, "Ставит задачи разметки", "AMQP")
Rel($ID_LABELING_WORKER, $ID_MESSAGE_BROKER, "Забирает задачи разметки", "AMQP")
Rel($ID_LABELING_WORKER, $ID_MESSAGE_BROKER, "Публикует события о новых обращениях", "AMQP")
Rel($ID_LABELING_WORKER, $ID_LLM_SERVICE, "Передаёт отзывы на разметку", "HTTPS / REST")
Rel($ID_BACKGROUND_WORKER, $ID_MESSAGE_BROKER, "Ставит задачи разметки", "AMQP")
Rel($ID_BACKGROUND_WORKER, $ID_MESSAGE_BROKER, "Забирает события по обращениям", "AMQP")
Rel($ID_BACKGROUND_WORKER, $ID_REVIEW_SOURCE, "Забирает отзывы", "HTTPS / REST")
Rel($ID_BACKGROUND_WORKER, $ID_NOTIFY_SERVICE, "Передаёт уведомления", "HTTPS, SMTP / TLS")
Rel($ID_NOTIFY_SERVICE, $ID_MOBILE_APP, "Доставляет push-уведомления", "APNs / FCM")
Rel($ID_NOTIFY_SERVICE, $ID_PRODUCT_OWNER, "Доставляет email о новом обращении", "SMTP / TLS")
Rel($ID_NOTIFY_SERVICE, $ID_HEAD_OF_DIRECTION, "Доставляет email об эскалации", "SMTP / TLS")

@enduml
