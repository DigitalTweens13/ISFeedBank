@startuml "ml_dynamic.puml"
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!include ../../main.puml

' Индивидуальная версия: ML, воркер разметки. Глоссарий ID и правила: см. context_l1.puml тимлида
' Нумерация шагов сквозная и совпадает с общей диаграммой dynamic_process.puml.
' Показаны шаги общего процесса, в которых участвует labeling_worker.

title Динамическая диаграмма. Фрагмент: воркер разметки

System_Boundary($ID_FEEDBACK_SYSTEM, "ИС управления обратной связью клиентов банка") {
    Container($ID_LABELING_WORKER, "Воркер разметки", "Python / Celery", "Кластеризация, мультилейбл-классификация тем, определение тональности, заведение обращений при негативе")
    Container($ID_MESSAGE_BROKER, "Брокер сообщений", "RabbitMQ", "Очереди reviews.labeling (задачи разметки) и cases.events (события по обращениям)")
    ContainerDb($ID_DATABASE, "База данных", "PostgreSQL 16", "Отзывы, разметка, обращения, история статусов, справочники, витрины аналитики")
}

Rel($ID_LABELING_WORKER, $ID_MESSAGE_BROKER, "6. Забирает задачу разметки из очереди reviews.labeling", "AMQP")
Rel($ID_LABELING_WORKER, $ID_DATABASE, "7. Получает текст отзыва и справочник тем", "SQL / TCP")
Rel($ID_LABELING_WORKER, $ID_DATABASE, "8. Сохраняет темы и тональность отзыва", "SQL / TCP")
Rel($ID_LABELING_WORKER, $ID_DATABASE, "9. Заводит обращение при негативе по значимой теме", "SQL / TCP")
Rel($ID_LABELING_WORKER, $ID_MESSAGE_BROKER, "10. Публикует событие case_created в очередь cases.events и подтверждает задачу", "AMQP")
@enduml
