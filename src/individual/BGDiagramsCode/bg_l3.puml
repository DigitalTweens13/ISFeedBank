@startuml "bg_l3.puml"
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

' Индивидуальная версия: TL, воркер фоновых задач. Глоссарий ID и правила: см. context_l1.puml тимлида
' ID компонентов: docs/glossary/components.csv (строки bg_*). Новых ID нет.

title Диаграмма компонентов (L3). Воркер фоновых задач

Container(message_broker, "Брокер сообщений", "RabbitMQ", "Очереди reviews.labeling (задачи разметки) и cases.events (события по обращениям)")
ContainerDb(database, "База данных", "PostgreSQL 16", "Отзывы, разметка, обращения, история статусов, справочники, витрины аналитики")
System_Ext(review_source, "Источник отзывов", "Агрегатор отзывов о банках с программным интерфейсом выгрузки")
System_Ext(notify_service, "Сервис уведомлений", "Почтовый сервер банка и push-сервисы APNs / FCM")

Container_Boundary(background_worker, "Воркер фоновых задач") {
    Component(bg_scheduler_comp, "Планировщик заданий", "Celery beat", "Расписания сбора отзывов и проверки сроков")
    Component(bg_collector_comp, "Сборщик отзывов", "Python, Celery task", "Забор отзывов из источника по расписанию")
    Component(bg_review_source_port, "Порт источника отзывов", "Python, httpx (адаптер)", "Адаптер review_source")
    Component(bg_labeling_publisher, "Публикатор задач разметки", "Python, kombu", "Ставит задачи по собранным отзывам")
    Component(bg_case_event_consumer, "Потребитель событий обращений", "Python, kombu, Pydantic", "Читает cases.events, назначает владельца и срок реакции")
    Component(bg_deadline_monitor_comp, "Контроль сроков", "Python, Celery task, SQLAlchemy", "Выбор обращений с истекающим сроком")
    Component(bg_escalation_comp, "Эскалация просрочки", "Python, SQLAlchemy", "Фиксация эскалации и передача руководителю")
    Component(bg_notification_comp, "Рассылка уведомлений", "Python", "Email и push через сервис уведомлений")
    Component(bg_notify_port, "Порт сервиса уведомлений", "Python, smtplib / httpx (адаптер)", "Адаптер notify_service")
}

Rel(bg_scheduler_comp, bg_collector_comp, "Запускает сбор отзывов по расписанию", "Python Call")
Rel(bg_scheduler_comp, bg_deadline_monitor_comp, "Запускает проверку сроков раз в минуту", "Python Call")
Rel(bg_collector_comp, bg_review_source_port, "Запрашивает новые отзывы", "Python Call")
Rel(bg_review_source_port, review_source, "Забирает новые отзывы по расписанию", "HTTPS / REST, JSON")
Rel(bg_collector_comp, database, "Сохраняет полученные отзывы", "SQL / TCP")
Rel(bg_collector_comp, bg_labeling_publisher, "Передаёт сохранённые отзывы на разметку", "Python Call")
Rel(bg_labeling_publisher, message_broker, "Ставит задачи разметки в очередь reviews.labeling", "AMQP")
Rel(bg_case_event_consumer, message_broker, "Забирает события из очереди cases.events, подтверждает после обработки", "AMQP")
Rel(bg_case_event_consumer, database, "Назначает обращению владельца и срок реакции", "SQL / TCP")
Rel(bg_case_event_consumer, bg_notification_comp, "Передаёт новое обращение для уведомления владельца", "Python Call")
Rel(bg_deadline_monitor_comp, database, "Выбирает обращения с истёкшим сроком", "SQL / TCP")
Rel(bg_deadline_monitor_comp, bg_escalation_comp, "Передаёт просроченное обращение", "Python Call")
Rel(bg_escalation_comp, database, "Фиксирует эскалацию просроченного обращения", "SQL / TCP")
Rel(bg_escalation_comp, bg_notification_comp, "Передаёт эскалацию для уведомления руководителя", "Python Call")
Rel(bg_notification_comp, bg_notify_port, "Передаёт уведомление на отправку", "Python Call")
Rel(bg_notify_port, notify_service, "Передаёт уведомление владельцу или руководителю", "SMTP / TLS, HTTPS")
@enduml
