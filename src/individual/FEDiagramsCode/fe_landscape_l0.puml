@startuml "fe_landscape_l0.puml"
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!include ../../main.puml

' Индивидуальная версия: FE, веб-панель и мобильное приложение. Глоссарий ID и правила: см. context_l1.puml тимлида
' Фокус: web_panel, mobile_app. Показаны только соседи фокуса и их окружение в ИТ-контуре банка; каждая связь взята из общей диаграммы L2 без изменений.

title Диаграмма системного ландшафта (L0) ИС управления обратной связью клиентов банка. Фокус: веб-панель и мобильное приложение

Person($ID_CX_ANALYST, "Аналитик клиентского опыта", "Загружает отзывы, анализирует настроения клиентов, формирует отчёты")
Person($ID_ADMIN, "Администратор системы", "Ведёт справочники тем, владельцев и нормативных сроков")
Person($ID_PRODUCT_OWNER, "Владелец продукта", "Отвечает за обращения по своему продуктовому направлению: ипотека, карты, приложение, отделения")
Person($ID_HEAD_OF_DIRECTION, "Руководитель направления", "Контролирует сроки реакции на обращения, получает эскалации")

Enterprise_Boundary($ID_BANK_FRAME, "ИТ-контур банка") {
    System_Ext($ID_BANK_IAM, "Система управления доступом банка", "Единый вход и ролевая модель сотрудников банка")
    System_Ext($ID_NOTIFY_SERVICE, "Сервис уведомлений", "Почтовый сервер банка и push-сервисы APNs / FCM")
    System_Boundary($ID_FEEDBACK_SYSTEM, "ИС управления обратной связью клиентов банка") {
        Container($ID_WEB_PANEL, "Веб-панель", "React / TypeScript, SPA", "Дашборд настроений, реестры отзывов и обращений, справочники, отчёты")
        Container($ID_MOBILE_APP, "Мобильное приложение", "TypeScript / React Native, iOS / Android", "Обращения и эскалации для владельцев продуктов и руководителей, смена статусов вне рабочего места")
        Container($ID_API_BACKEND, "Backend API", "Python / FastAPI, JWT", "REST API, проверка доступа, статусная модель обращений, назначение владельцев, отчёты")
    }
}


Rel($ID_CX_ANALYST, $ID_WEB_PANEL, "Загружает пакеты отзывов, изучает дашборд, формирует отчёты", "HTTPS")
Rel($ID_ADMIN, $ID_WEB_PANEL, "Настраивает темы, владельцев и сроки реакции", "HTTPS")
Rel($ID_PRODUCT_OWNER, $ID_WEB_PANEL, "Берёт обращения своего направления в работу", "HTTPS")
Rel($ID_PRODUCT_OWNER, $ID_MOBILE_APP, "Меняет статусы обращений вне рабочего места", "HTTPS")
Rel($ID_HEAD_OF_DIRECTION, $ID_MOBILE_APP, "Просматривает эскалации и просроченные обращения", "HTTPS")
Rel($ID_WEB_PANEL, $ID_BANK_IAM, "Перенаправляет пользователя на страницу единого входа", "HTTPS / OAuth 2.0 (OIDC)")
Rel($ID_MOBILE_APP, $ID_BANK_IAM, "Перенаправляет пользователя на страницу единого входа", "HTTPS / OAuth 2.0 (OIDC)")
Rel($ID_WEB_PANEL, $ID_API_BACKEND, "Запрашивает отзывы, обращения, аналитику и справочники", "HTTPS / JSON, REST")
Rel($ID_MOBILE_APP, $ID_API_BACKEND, "Запрашивает обращения и передаёт смену статуса", "HTTPS / JSON, REST")
Rel($ID_API_BACKEND, $ID_BANK_IAM, "Проверяет подлинность и роли сотрудников", "HTTPS / OAuth 2.0 (OIDC)")
Rel($ID_NOTIFY_SERVICE, $ID_MOBILE_APP, "Доставляет push-уведомления об обращениях и эскалациях", "APNs / FCM")
Rel($ID_NOTIFY_SERVICE, $ID_PRODUCT_OWNER, "Сообщает о новом обращении по направлению", "SMTP / TLS")
Rel($ID_NOTIFY_SERVICE, $ID_HEAD_OF_DIRECTION, "Сообщает о просрочке и эскалации", "SMTP / TLS")
@enduml
