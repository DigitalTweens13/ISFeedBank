@startuml "fe_context_l1.puml"
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
!include ../../main.puml

' Индивидуальная версия: FE, точки входа пользователей. Глоссарий ID и правила: см. context_l1.puml тимлида

title Диаграмма системного контекста (L1) ИС управления обратной связью клиентов банка. Фокус: точки входа пользователей

Person($ID_CX_ANALYST, "Аналитик клиентского опыта", "Загружает отзывы, анализирует настроения клиентов, формирует отчёты")
Person($ID_PRODUCT_OWNER, "Владелец продукта", "Отвечает за обращения по своему продуктовому направлению: ипотека, карты, приложение, отделения")
Person($ID_HEAD_OF_DIRECTION, "Руководитель направления", "Контролирует сроки реакции на обращения, получает эскалации")
Person($ID_ADMIN, "Администратор системы", "Ведёт справочники тем, владельцев и нормативных сроков")

System($ID_FEEDBACK_SYSTEM, "ИС управления обратной связью клиентов банка", "Собирает и размечает отзывы, заводит обращения по негативу, назначает их владельцам, контролирует сроки и строит аналитику")

System_Ext($ID_REVIEW_SOURCE, "Источник отзывов", "Агрегатор отзывов о банках с программным интерфейсом выгрузки")
System_Ext($ID_LLM_SERVICE, "Сервис языковой модели", "Внешняя большая языковая модель для определения тем и тональности отзывов")
System_Ext($ID_NOTIFY_SERVICE, "Сервис уведомлений", "Почтовый сервер банка и push-сервисы APNs / FCM")
System_Ext($ID_REPORTING_SYSTEM, "Система отчётности банка", "Корпоративное хранилище управленческой отчётности")
System_Ext($ID_BANK_IAM, "Система управления доступом банка", "Единый вход и ролевая модель сотрудников банка")

' --- фокус ---
Rel($ID_CX_ANALYST, $ID_FEEDBACK_SYSTEM, "Загружает пакет отзывов через веб-панель", "HTTPS")
Rel($ID_CX_ANALYST, $ID_FEEDBACK_SYSTEM, "Изучает дашборд настроений и формирует отчёты в веб-панели", "HTTPS")
Rel($ID_PRODUCT_OWNER, $ID_FEEDBACK_SYSTEM, "Берёт обращения в работу на доске веб-панели", "HTTPS")
Rel($ID_PRODUCT_OWNER, $ID_FEEDBACK_SYSTEM, "Меняет статус обращения из мобильного приложения", "HTTPS")
Rel($ID_HEAD_OF_DIRECTION, $ID_FEEDBACK_SYSTEM, "Просматривает эскалации в мобильном приложении", "HTTPS")
Rel($ID_ADMIN, $ID_FEEDBACK_SYSTEM, "Настраивает справочники тем, владельцев и сроков в веб-панели", "HTTPS")
Rel($ID_CX_ANALYST, $ID_BANK_IAM, "Входит через единый вход банка", "HTTPS / OAuth 2.0 (OIDC)")
Rel($ID_PRODUCT_OWNER, $ID_BANK_IAM, "Входит через единый вход банка", "HTTPS / OAuth 2.0 (OIDC)")
Rel($ID_HEAD_OF_DIRECTION, $ID_BANK_IAM, "Входит через единый вход банка", "HTTPS / OAuth 2.0 (OIDC)")
Rel($ID_ADMIN, $ID_BANK_IAM, "Входит через единый вход банка", "HTTPS / OAuth 2.0 (OIDC)")
Rel($ID_FEEDBACK_SYSTEM, $ID_BANK_IAM, "Проверяет токен и роль вошедшего сотрудника", "HTTPS / OAuth 2.0 (OIDC)")
Rel($ID_FEEDBACK_SYSTEM, $ID_NOTIFY_SERVICE, "Передаёт push и email о новых обращениях и эскалациях", "HTTPS, SMTP / TLS")
Rel($ID_NOTIFY_SERVICE, $ID_PRODUCT_OWNER, "Доставляет push и email о новом обращении", "SMTP / TLS, APNs / FCM")
Rel($ID_NOTIFY_SERVICE, $ID_HEAD_OF_DIRECTION, "Доставляет push и email об эскалации", "SMTP / TLS, APNs / FCM")

' --- вне фокуса ---
Rel($ID_FEEDBACK_SYSTEM, $ID_REVIEW_SOURCE, "Забирает новые отзывы", "HTTPS / REST")
Rel($ID_FEEDBACK_SYSTEM, $ID_LLM_SERVICE, "Передаёт отзывы на разметку", "HTTPS / REST")
Rel($ID_FEEDBACK_SYSTEM, $ID_REPORTING_SYSTEM, "Выгружает отчёты", "HTTPS / REST")

@enduml
