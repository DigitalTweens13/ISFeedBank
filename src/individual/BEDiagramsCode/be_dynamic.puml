@startuml "be_dynamic.puml"
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!include ../../main.puml

' Индивидуальная версия: BE, Backend API. Глоссарий ID и правила: см. context_l1.puml тимлида
' Нумерация шагов сквозная и совпадает с общей диаграммой dynamic_process.puml.
' Показаны шаги общего процесса, в которых участвует api_backend.

title Динамическая диаграмма. Фрагмент: Backend API

System_Ext($ID_BANK_IAM, "Система управления доступом банка", "Единый вход и ролевая модель сотрудников банка")
System_Boundary($ID_FEEDBACK_SYSTEM, "ИС управления обратной связью клиентов банка") {
    Container($ID_WEB_PANEL, "Веб-панель", "React / TypeScript, SPA", "Дашборд настроений, реестры отзывов и обращений, справочники, отчёты")
    Container($ID_API_BACKEND, "Backend API", "Python / FastAPI, JWT", "REST API, проверка доступа, статусная модель обращений, назначение владельцев, отчёты")
    ContainerDb($ID_DATABASE, "База данных", "PostgreSQL 16", "Отзывы, разметка, обращения, история статусов, справочники, витрины аналитики")
    Container($ID_MESSAGE_BROKER, "Брокер сообщений", "RabbitMQ", "Очереди reviews.labeling (задачи разметки) и cases.events (события по обращениям)")
    Container($ID_MOBILE_APP, "Мобильное приложение", "TypeScript / React Native, iOS / Android", "Обращения и эскалации для владельцев продуктов и руководителей, смена статусов вне рабочего места")
    ContainerDb($ID_CACHE, "Кэш", "Redis", "Предрассчитанные агрегаты дашборда")
}

Rel($ID_WEB_PANEL, $ID_API_BACKEND, "2. Отправляет пакет отзывов (POST /feedback/batches) с токеном сессии", "HTTPS / JSON, REST")
Rel($ID_API_BACKEND, $ID_BANK_IAM, "3. Проверяет подпись токена по открытым ключам и получает роли сотрудника", "HTTPS / OAuth 2.0 (OIDC)")
Rel($ID_API_BACKEND, $ID_DATABASE, "4. Обезличивает, отсеивает дубли и сохраняет принятые отзывы", "SQL / TCP")
Rel($ID_API_BACKEND, $ID_MESSAGE_BROKER, "5. Ставит задачу разметки на каждый принятый отзыв в очередь reviews.labeling", "AMQP")
Rel($ID_MOBILE_APP, $ID_API_BACKEND, "16. Запрашивает карточку обращения (GET /cases/{case_id})", "HTTPS / JSON, REST")
Rel($ID_API_BACKEND, $ID_DATABASE, "17. Читает обращение и историю статусов", "SQL / TCP")
Rel($ID_MOBILE_APP, $ID_API_BACKEND, "18. Передаёт смену статуса на «в работе» (PATCH /cases/{case_id}/status)", "HTTPS / JSON, REST")
Rel($ID_API_BACKEND, $ID_DATABASE, "19. Проверяет допустимость перехода и записывает новый статус", "SQL / TCP")
Rel($ID_API_BACKEND, $ID_CACHE, "20. Сбрасывает устаревшие агрегаты дашборда", "RESP / TCP")
Rel($ID_MOBILE_APP, $ID_API_BACKEND, "29. Запрашивает эскалированные обращения направления (GET /cases)", "HTTPS / JSON, REST")
Rel($ID_API_BACKEND, $ID_DATABASE, "30. Читает эскалированные обращения направления", "SQL / TCP")
@enduml
