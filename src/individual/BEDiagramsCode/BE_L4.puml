@startuml "BE_L4.puml"
!include ../../main.puml

' Индивидуальная версия: BE, Backend API.
' Детализация компонента api_feedback_ingestion_comp.
' Глоссарий компонентов и классов: docs/glossary/components.csv.
' Паттерн проектирования: Стратегия.

title Диаграмма классов UML (L4). Приём и валидация отзывов (паттерн «Стратегия»)

' Основной сервис

class FeedbackIngestionService {
    -guard: AccessGuard
    -repo: FeedbackRepository
    -publisher: MarkupTaskPublisher
    -clock: Clock
    -max_batch: int
    +parser: StrategySlot[BatchParserStrategy]
    +validator: StrategySlot[ValidationStrategy]
    +anonymizer: StrategySlot[AnonymizationStrategy]
    +deduplicator: StrategySlot[DeduplicationStrategy]
    --
    +ingest(token, payload, parser, validation): BatchReport
    -_enqueue(accepted, batch_id, report): bool
    +catalog(): StrategyCatalog
}

' Модели данных

class Feedback {
    +id: str
    +fingerprint: str
    +text: str (обезличен)
    +rating: int
    +published_at: datetime
    +status: str = NEW
}

class BatchReport {
    +batch_id: str
    +total: int
    +accepted: int
    +duplicates: int
    +rejected: list[RejectedRecord]
    +markup_queued: bool
    +warnings: list[str]
    --
    +as_dict(): dict
}

' Контейнер стратегий

class "StrategySlot<S>" as StrategySlot {
    -kind: str
    -strategies: dict[str, S]
    -active: str
    --
    +current: S
    +get(name): S
    +select(name): void
    +register(name, strategy): void
    +describe(): dict
}

' Интерфейсы внешних зависимостей

interface MarkupTaskPublisher <<interface>> {
    +publish(tasks): void
}

interface FeedbackRepository <<interface>> {
    +existing_fingerprints(fingerprints): set[str]
    +save_batch(feedbacks): void
}

interface AccessGuard <<interface>> {
    +authorize(token, operation): Principal
}

' Интерфейсы стратегий

interface BatchParserStrategy <<interface>> {
    +parse(payload): list[dict]
}

interface ValidationStrategy <<interface>> {
    +validate(record): list[Violation]
}

interface AnonymizationStrategy <<interface>> {
    +anonymize(text): str
}

interface DeduplicationStrategy <<interface>> {
    +fingerprint(record): str
}

' Стратегии парсинга

class JsonBatchParser {
    +parse(payload): list[dict]
}

class CsvBatchParser {
    +parse(payload): list[dict]
}

' Стратегии валидации

class RuleChainValidation {
    -rules: list[ValidationRule]
    --
    +validate(record): list[Violation]
}

interface ValidationRule <<interface>> {
    +check(record): Iterable[Violation]
}

class AggregatorValidation {
    +__init__(now_provider, allowed_sources)
}

class FileImportValidation {
    +__init__(now_provider)
}

' Стратегии обезличивания

abstract class _RegexAnonymizer {
    #_replace(kind, matched): str
    +anonymize(text): str
}

class NoopAnonymizer {
    +anonymize(text): str
}

class PartialMaskAnonymizer {
    #_replace(kind, matched): str
}

class PlaceholderAnonymizer {
    #_replace(kind, matched): str
}

' Стратегии дедупликации

class ContentHashFingerprint {
    +fingerprint(record): str
}

class ExternalIdFingerprint {
    -fallback: DeduplicationStrategy
    --
    +fingerprint(record): str
}

' Зависимости основного сервиса

FeedbackIngestionService ..> Feedback : <<create>>
FeedbackIngestionService ..> BatchReport : <<create>>

FeedbackIngestionService "1" *-- "4" StrategySlot

FeedbackIngestionService ..> MarkupTaskPublisher : Публикует задачи разметки
FeedbackIngestionService ..> FeedbackRepository : Сохраняет отзывы
FeedbackIngestionService ..> AccessGuard : Проверяет права доступа

' Агрегация стратегий

StrategySlot o-- "1..*" BatchParserStrategy
StrategySlot o-- "1..*" ValidationStrategy
StrategySlot o-- "1..*" AnonymizationStrategy
StrategySlot o-- "1..*" DeduplicationStrategy

' Реализация стратегий парсинга

BatchParserStrategy <|.. JsonBatchParser
BatchParserStrategy <|.. CsvBatchParser

' Реализация стратегий валидации

ValidationStrategy <|.. RuleChainValidation

RuleChainValidation o-- "1..*" ValidationRule

RuleChainValidation <|-- AggregatorValidation
RuleChainValidation <|-- FileImportValidation

' Реализация стратегий обезличивания

AnonymizationStrategy <|.. _RegexAnonymizer
AnonymizationStrategy <|.. NoopAnonymizer

_RegexAnonymizer <|-- PartialMaskAnonymizer
_RegexAnonymizer <|-- PlaceholderAnonymizer

' Реализация стратегий дедупликации

DeduplicationStrategy <|.. ContentHashFingerprint
DeduplicationStrategy <|.. ExternalIdFingerprint

ExternalIdFingerprint ..> DeduplicationStrategy : fallback 0..1

@enduml
