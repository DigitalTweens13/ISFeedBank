@startuml "be_context_l1.puml"
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
!include ../../main.puml

' Индивидуальная версия: BE, запросы через API. Глоссарий ID и правила: см. context_l1.puml тимлида
 
title Диаграмма системного контекста (L1) ИС управления обратной связью клиентов банка. Фокус: операции пользователей, доступ и отчётность
 
Person($ID_CX_ANALYST, "Аналитик клиентского опыта", "Загружает отзывы, анализирует настроения клиентов, формирует отчёты")
Person($ID_PRODUCT_OWNER, "Владелец продукта", "Отвечает за обращения по своему продуктовому направлению: ипотека, карты, приложение, отделения")
Person($ID_HEAD_OF_DIRECTION, "Руководитель направления", "Контролирует сроки реакции на обращения, получает эскалации")
Person($ID_ADMIN, "Администратор системы", "Ведёт справочники тем, владельцев и нормативных сроков")
 
System($ID_FEEDBACK_SYSTEM, "ИС управления обратной связью клиентов банка", "Собирает и размечает отзывы, заводит обращения по негативу, назначает их владельцам, контролирует сроки и строит аналитику")
 
System_Ext($ID_REVIEW_SOURCE, "Источник отзывов", "Агрегатор отзывов о банках с программным интерфейсом выгрузки")
System_Ext($ID_LLM_SERVICE, "Сервис языковой модели", "Внешняя большая языковая модель для определения тем и тональности отзывов")
System_Ext($ID_NOTIFY_SERVICE, "Сервис уведомлений", "Почтовый сервер банка и push-сервисы APNs / FCM")
System_Ext($ID_REPORTING_SYSTEM, "Система отчётности банка", "Корпоративное хранилище управленческой отчётности")
System_Ext($ID_BANK_IAM, "Система управления доступом банка", "Единый вход и ролевая модель сотрудников банка")
 
' --- фокус ---
Rel($ID_CX_ANALYST, $ID_FEEDBACK_SYSTEM, "Загружает пакет отзывов", "HTTPS")
Rel($ID_CX_ANALYST, $ID_FEEDBACK_SYSTEM, "Формирует отчёт за период", "HTTPS")
Rel($ID_PRODUCT_OWNER, $ID_FEEDBACK_SYSTEM, "Получает обращения своего направления", "HTTPS")
Rel($ID_PRODUCT_OWNER, $ID_FEEDBACK_SYSTEM, "Переводит обращение по статусам, при отклонении указывает причину", "HTTPS")
Rel($ID_HEAD_OF_DIRECTION, $ID_FEEDBACK_SYSTEM, "Получает просроченные и эскалированные обращения", "HTTPS")
Rel($ID_ADMIN, $ID_FEEDBACK_SYSTEM, "Настраивает справочник тем и владельцев", "HTTPS")
Rel($ID_ADMIN, $ID_FEEDBACK_SYSTEM, "Задаёт нормативные сроки реакции по темам", "HTTPS")
Rel($ID_FEEDBACK_SYSTEM, $ID_BANK_IAM, "Получает открытые ключи для проверки подписи токенов", "HTTPS / OAuth 2.0 (OIDC)")
Rel($ID_FEEDBACK_SYSTEM, $ID_BANK_IAM, "Получает роли сотрудника для разграничения прав", "HTTPS / OAuth 2.0 (OIDC)")
Rel($ID_FEEDBACK_SYSTEM, $ID_REPORTING_SYSTEM, "Выгружает отчёт о закрытых обращениях и времени реакции", "HTTPS / REST, JSON")
 
' --- вне фокуса ---
Rel($ID_FEEDBACK_SYSTEM, $ID_REVIEW_SOURCE, "Забирает новые отзывы", "HTTPS / REST")
Rel($ID_FEEDBACK_SYSTEM, $ID_LLM_SERVICE, "Передаёт отзывы на разметку", "HTTPS / REST")
Rel($ID_FEEDBACK_SYSTEM, $ID_NOTIFY_SERVICE, "Передаёт уведомления", "HTTPS, SMTP / TLS")
Rel($ID_NOTIFY_SERVICE, $ID_PRODUCT_OWNER, "Сообщает о новом обращении", "SMTP / TLS, APNs / FCM")
Rel($ID_NOTIFY_SERVICE, $ID_HEAD_OF_DIRECTION, "Сообщает об эскалации", "SMTP / TLS, APNs / FCM")
 
@enduml
