@startuml "be_deployment.puml"
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Deployment.puml
!include ../../main.puml

' Индивидуальная версия: BE, Backend API. Глоссарий ID и правила: см. context_l1.puml тимлида
' ID узлов dn_* и контейнера database_replica относятся только к диаграмме развёртывания (ЛР № 4).
' Узлы, порты и протоколы взяты из общей диаграммы deployment_l2.puml без изменений.

title Диаграмма развёртывания (L2). Фрагмент: Backend API

Deployment_Node($ID_DN_EMPLOYEE_PC, "Рабочее место сотрудника", "Windows / macOS", "Корпоративный компьютер сотрудника банка") {
    Deployment_Node($ID_DN_BROWSER, "Веб-браузер", "Chrome / Edge", "Исполняет SPA веб-панели") {
        Container($ID_WEB_PANEL, "Веб-панель", "React / TypeScript, SPA", "Дашборд настроений, реестры отзывов и обращений, справочники, отчёты")
    }
}
Deployment_Node($ID_DN_PHONE, "Смартфон сотрудника", "iOS / Android", "Устройство владельца продукта или руководителя направления") {
    Container($ID_MOBILE_APP, "Мобильное приложение", "TypeScript / React Native, iOS / Android", "Обращения и эскалации для владельцев продуктов и руководителей, смена статусов вне рабочего места")
}
Deployment_Node($ID_DN_DMZ, "Периметр банка (DMZ)", "Межсетевой экран, VLAN DMZ", "Единственная точка входа пользователей в систему") {
    Deployment_Node($ID_DN_NGINX, "Nginx reverse proxy, 2 экземпляра", "Nginx, порт 443, TLS 1.3", "Отдаёт статику SPA, завершает TLS, балансирует запросы к API по least_conn, общий виртуальный адрес keepalived")
}
Deployment_Node($ID_DN_APP_ZONE, "Кластер приложений", "Docker / Kubernetes, VLAN приложений", "Входящие соединения только от Nginx и между приложениями") {
    Deployment_Node($ID_DN_API, "Под Backend API, 2 реплики", "Docker, Python, uvicorn, порт 8000", "Реплики без состояния: сессия хранится в токене") {
        Container($ID_API_BACKEND, "Backend API", "Python / FastAPI, JWT", "REST API, проверка доступа, статусная модель обращений, назначение владельцев, отчёты")
    }
}
Deployment_Node($ID_DN_DATA_ZONE, "Зона данных", "VLAN данных", "Доступ только из кластера приложений") {
    Deployment_Node($ID_DN_DB_PRIMARY, "Сервер БД, primary", "Linux, PostgreSQL, порт 5432", "Принимает запись и чтение") {
        ContainerDb($ID_DATABASE, "База данных", "PostgreSQL 16", "Отзывы, разметка, обращения, история статусов, справочники, витрины аналитики")
    }
    Deployment_Node($ID_DN_DB_REPLICA, "Сервер БД, replica", "Linux, PostgreSQL, порт 5432", "Потоковая репликация, автопереключение при отказе primary (Patroni)") {
        ContainerDb($ID_DATABASE_REPLICA, "База данных (реплика)", "PostgreSQL 16", "Горячая копия базы данных: чтение и переключение при отказе primary")
    }
    Deployment_Node($ID_DN_REDIS, "Redis, master и replica", "Redis, порт 6379, Sentinel", "Автоматическое переключение на replica при отказе master") {
        ContainerDb($ID_CACHE, "Кэш", "Redis", "Предрассчитанные агрегаты дашборда")
    }
    Deployment_Node($ID_DN_MQ, "Кластер RabbitMQ, 3 узла", "RabbitMQ, порт 5671 (AMQP + TLS), порт 15672 только из сети администрирования", "Очереди quorum: каждое сообщение хранится на большинстве узлов") {
        Container($ID_MESSAGE_BROKER, "Брокер сообщений", "RabbitMQ", "Очереди reviews.labeling (задачи разметки) и cases.events (события по обращениям)")
    }
}

System_Ext($ID_BANK_IAM, "Система управления доступом банка", "Единый вход и ролевая модель сотрудников банка")
System_Ext($ID_REPORTING_SYSTEM, "Система отчётности банка", "Корпоративное хранилище управленческой отчётности")

Rel($ID_WEB_PANEL, $ID_DN_NGINX, "Загружает статику SPA и вызывает REST API", "HTTPS, TCP 443, TLS 1.3")
Rel($ID_MOBILE_APP, $ID_DN_NGINX, "Вызывает REST API", "HTTPS, TCP 443, TLS 1.3")
Rel($ID_DN_NGINX, $ID_API_BACKEND, "Передаёт запросы, балансируя между репликами", "HTTP, TCP 8000, внутренняя сеть")
Rel($ID_WEB_PANEL, $ID_BANK_IAM, "Перенаправляет пользователя на страницу единого входа", "HTTPS, TCP 443, TLS 1.3 / OAuth 2.0 (OIDC)")
Rel($ID_MOBILE_APP, $ID_BANK_IAM, "Перенаправляет пользователя на страницу единого входа", "HTTPS, TCP 443, TLS 1.3 / OAuth 2.0 (OIDC)")
Rel($ID_API_BACKEND, $ID_BANK_IAM, "Проверяет подлинность и роли сотрудников", "HTTPS, TCP 443, TLS 1.3 / OAuth 2.0 (OIDC)")
Rel($ID_API_BACKEND, $ID_DATABASE, "Сохраняет и получает отзывы, обращения, историю статусов и справочники", "SQL, TCP 5432, TLS")
Rel($ID_API_BACKEND, $ID_CACHE, "Получает и обновляет агрегаты дашборда", "RESP, TCP 6379, TLS")
Rel($ID_API_BACKEND, $ID_MESSAGE_BROKER, "Ставит задачи разметки для загруженного пакета отзывов", "AMQP, TCP 5671, TLS")
Rel($ID_API_BACKEND, $ID_REPORTING_SYSTEM, "Выгружает отчёты за период", "HTTPS, TCP 443, TLS 1.3 / REST, JSON")
Rel($ID_DATABASE_REPLICA, $ID_DATABASE, "Получает журнал изменений WAL от primary", "Потоковая репликация PostgreSQL, TCP 5432, TLS")
@enduml
