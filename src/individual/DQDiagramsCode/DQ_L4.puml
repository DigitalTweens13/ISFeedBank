@startuml

title Диаграмма классов UML (Level 4) — Очередь задач разметки reviews.labeling (паттерн «Стратегия»)

top to bottom direction

skinparam backgroundColor white
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam nodesep 40
skinparam ranksep 50
skinparam linetype spline

skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #AAAAAA
    ArrowColor #555555
    FontColor #000000
    FontStyle bold
}

skinparam note {
    BackgroundColor #FFFFDD
    BorderColor #AAAAAA
    FontColor #000000
}

' ==========================================
' Клиент
' ==========================================

class RabbitExchangeManager <<client>> {
    +plan(message: Message): list[PublishTarget]
}

' ==========================================
' Контекст стратегии
' ==========================================

class RabbitQueueBase <<context>> {
    -_name: str
    -_order: DeliveryOrderStrategy
    -_validation: ValidationStrategy
    -_overflow: OverflowStrategy
    -_max_length: int | None
    -_max_priority: int
    --
    +set_order_strategy(order: DeliveryOrderStrategy): None
    +set_validation_strategy(validation: ValidationStrategy): None
    +arguments(): dict
    +declare(channel: AmqpChannelLike): None
    +prepare(message: Message): int
}

note right of RabbitQueueBase
    set_order_strategy() подменяет
    алгоритм выдачи во время работы,
    код очереди не меняется
end note

' ==========================================
' Очередь задач разметки
' ==========================================

class RabbitLabelingQueue {
    +DEFAULT_MAX_LENGTH: int = 10000
    --
    +__init__(order: DeliveryOrderStrategy = None,
    validation: ValidationStrategy = None,
    overflow: OverflowStrategy = None,
    max_length: int = 10000)
}

' ==========================================
' Интерфейс стратегии порядка выдачи
' ==========================================

interface DeliveryOrderStrategy <<interface>> {
    +priority_for(message: Message, max_priority: int): int
}

' ==========================================
' Реализации стратегии порядка выдачи
' ==========================================

class FifoOrder {
    +priority_for(message: Message, max_priority: int): int
}

class PriorityOrder {
    -_policy: PriorityPolicy
    --
    +__init__(policy: PriorityPolicy)
    +priority_for(message: Message, max_priority: int): int
}

' ==========================================
' Интерфейс политики приоритизации
' ==========================================

interface PriorityPolicy <<interface>> {
    +priority_of(message: Message): int
}

' ==========================================
' Реализации политики приоритизации
' ==========================================

class NegativeReviewsFirstPolicy {
    +priority_of(message: Message): int
}

note right of NegativeReviewsFirstPolicy
    по умолчанию:
    оценка 1 → приоритет 4
    оценка 5 → приоритет 0
end note

class SourcePriorityPolicy {
    -_weights: dict[str, int]
    --
    +__init__(weights: dict = None)
    +priority_of(message: Message): int
}

class MessagePriorityPolicy {
    +priority_of(message: Message): int
}

' ==========================================
' Зависимость клиента от контекста
' ==========================================

RabbitExchangeManager ..> RabbitQueueBase : prepare(message)

' ==========================================
' Наследование очереди
' ==========================================

RabbitQueueBase <|-- RabbitLabelingQueue

' ==========================================
' Композиция контекста и стратегии
' ==========================================

RabbitQueueBase "1" *-- "1" DeliveryOrderStrategy : order

' ==========================================
' Реализация стратегий порядка выдачи
' ==========================================

DeliveryOrderStrategy <|.. FifoOrder

DeliveryOrderStrategy <|.. PriorityOrder

' ==========================================
' Композиция стратегии и политики
' ==========================================

PriorityOrder "1" *-- "1" PriorityPolicy : policy

' ==========================================
' Реализация политик приоритизации
' ==========================================

PriorityPolicy <|.. NegativeReviewsFirstPolicy

PriorityPolicy <|.. SourcePriorityPolicy

PriorityPolicy <|.. MessagePriorityPolicy

' ==========================================
' Настройка расположения элементов
' ==========================================

RabbitLabelingQueue -[hidden]right- DeliveryOrderStrategy

FifoOrder -[hidden]right- PriorityOrder

NegativeReviewsFirstPolicy -[hidden]right- SourcePriorityPolicy

SourcePriorityPolicy -[hidden]right- MessagePriorityPolicy

@enduml
