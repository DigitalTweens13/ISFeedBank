@startuml "landscape_l0.puml"
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!include main.puml

' ГЛОССАРИЙ ID: см. context_l1.puml тимлида (единый для всей команды, менять только через ТЛ)
' Правила: только Rel(); без Rel_D/R/L/U; описания элементов дословно из общих диаграмм.
' Внутри ИТ-контура банка: единый вход, система отчётности и почтовый сервер банка. Снаружи: агрегатор отзывов и push-сервисы APNs / FCM (часть notify_service).

LAYOUT_WITH_LEGEND()

title Диаграмма системного ландшафта (L0). ИС управления обратной связью клиентов банка в ИТ-контуре банка

Person($ID_CX_ANALYST, "Аналитик клиентского опыта", "Загружает отзывы, анализирует настроения клиентов, формирует отчёты")
Person($ID_PRODUCT_OWNER, "Владелец продукта", "Отвечает за обращения по своему продуктовому направлению: ипотека, карты, приложение, отделения")
Person($ID_HEAD_OF_DIRECTION, "Руководитель направления", "Контролирует сроки реакции на обращения, получает эскалации")
Person($ID_ADMIN, "Администратор системы", "Ведёт справочники тем, владельцев и нормативных сроков")

Enterprise_Boundary(bank_it, "ИТ-контур банка") {
    System_Ext($ID_BANK_IAM, "Система управления доступом банка", "Единый вход и ролевая модель сотрудников банка")
    System_Ext($ID_REPORTING_SYSTEM, "Система отчётности банка", "Корпоративное хранилище управленческой отчётности")
    System_Ext($ID_NOTIFY_SERVICE, "Сервис уведомлений", "Почтовый сервер банка и push-сервисы APNs / FCM")
    System($ID_FEEDBACK_SYSTEM, "ИС управления обратной связью клиентов банка", "Собирает и размечает отзывы, заводит обращения по негативу, назначает их владельцам, контролирует сроки и строит аналитику")
}

System_Ext($ID_REVIEW_SOURCE, "Источник отзывов", "Агрегатор отзывов о банках с программным интерфейсом выгрузки")

Rel($ID_CX_ANALYST, $ID_FEEDBACK_SYSTEM, "Загружает пакеты отзывов, изучает дашборд настроений, формирует отчёты", "HTTPS")
Rel($ID_PRODUCT_OWNER, $ID_FEEDBACK_SYSTEM, "Берёт обращения своего направления в работу, меняет их статусы", "HTTPS")
Rel($ID_HEAD_OF_DIRECTION, $ID_FEEDBACK_SYSTEM, "Просматривает просроченные обращения и эскалации", "HTTPS")
Rel($ID_ADMIN, $ID_FEEDBACK_SYSTEM, "Настраивает справочник тем, владельцев и сроков реакции", "HTTPS")
Rel($ID_CX_ANALYST, $ID_BANK_IAM, "Входит через единый вход банка", "HTTPS / OAuth 2.0 (OIDC)")
Rel($ID_PRODUCT_OWNER, $ID_BANK_IAM, "Входит через единый вход банка", "HTTPS / OAuth 2.0 (OIDC)")
Rel($ID_HEAD_OF_DIRECTION, $ID_BANK_IAM, "Входит через единый вход банка", "HTTPS / OAuth 2.0 (OIDC)")
Rel($ID_ADMIN, $ID_BANK_IAM, "Входит через единый вход банка", "HTTPS / OAuth 2.0 (OIDC)")
Rel($ID_FEEDBACK_SYSTEM, $ID_REVIEW_SOURCE, "Забирает новые отзывы по расписанию", "HTTPS / REST, JSON")
Rel($ID_FEEDBACK_SYSTEM, $ID_NOTIFY_SERVICE, "Передаёт уведомления о новых обращениях и эскалациях", "SMTP / TLS, HTTPS")
Rel($ID_FEEDBACK_SYSTEM, $ID_REPORTING_SYSTEM, "Выгружает отчёты о закрытых обращениях и времени реакции", "HTTPS / REST, JSON")
Rel($ID_FEEDBACK_SYSTEM, $ID_BANK_IAM, "Проверяет подлинность и роли сотрудников", "HTTPS / OAuth 2.0 (OIDC)")
Rel($ID_NOTIFY_SERVICE, $ID_PRODUCT_OWNER, "Сообщает о новом обращении по направлению", "SMTP / TLS, APNs / FCM")
Rel($ID_NOTIFY_SERVICE, $ID_HEAD_OF_DIRECTION, "Сообщает о просрочке и эскалации", "SMTP / TLS, APNs / FCM")
@enduml
