@startuml "containers_l2.puml"
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!include main.puml

' ============================================================
' ГЛОССАРИЙ ID (единый для всей команды, менять только через ТЛ)
' Персоны:        cx_analyst, product_owner, head_of_direction, admin
' Система:        feedback_system
' Контейнеры:     web_panel, mobile_app, api_backend, labeling_worker,
'                 background_worker, message_broker, database, cache
' Внешние:        review_source, notify_service,
'                 reporting_system, bank_iam
' Правила: только Rel(); без Rel_D/R/L/U; без skinparam в личных файлах;
'          у каждой связи одно действие и протокол.
' Описания элементов одинаковы в общей и во всех личных версиях.
' ============================================================

' Порты не указываются: они относятся к диаграмме развёртывания (ЛР №4)

LAYOUT_WITH_LEGEND()

title Диаграмма контейнеров (L2). ИС управления обратной связью клиентов банка

Person($ID_CX_ANALYST, "Аналитик клиентского опыта", "Загружает отзывы, анализирует настроения клиентов, формирует отчёты")
Person($ID_PRODUCT_OWNER, "Владелец продукта", "Отвечает за обращения по своему продуктовому направлению: ипотека, карты, приложение, отделения")
Person($ID_HEAD_OF_DIRECTION, "Руководитель направления", "Контролирует сроки реакции на обращения, получает эскалации")
Person($ID_ADMIN, "Администратор системы", "Ведёт справочники тем, владельцев и нормативных сроков")

System_Ext($ID_REVIEW_SOURCE, "Источник отзывов", "Агрегатор отзывов о банках с программным интерфейсом выгрузки")
System_Ext($ID_NOTIFY_SERVICE, "Сервис уведомлений", "Почтовый сервер банка и push-сервисы APNs / FCM")
System_Ext($ID_REPORTING_SYSTEM, "Система отчётности банка", "Корпоративное хранилище управленческой отчётности")
System_Ext($ID_BANK_IAM, "Система управления доступом банка", "Единый вход и ролевая модель сотрудников банка")

System_Boundary($ID_FEEDBACK_SYSTEM, "ИС управления обратной связью клиентов банка") {
    Container($ID_WEB_PANEL, "Веб-панель", "React / TypeScript, SPA", "Дашборд настроений, реестры отзывов и обращений, справочники, отчёты")
    Container($ID_MOBILE_APP, "Мобильное приложение", "TypeScript / React Native, iOS / Android", "Обращения и эскалации для владельцев продуктов и руководителей, смена статусов вне рабочего места")
    Container($ID_API_BACKEND, "Backend API", "Python / FastAPI, JWT", "REST API, проверка доступа, статусная модель обращений, назначение владельцев, отчёты")
    Container($ID_LABELING_WORKER, "Воркер разметки", "Python / Celery", "Кластеризация, мультилейбл-классификация тем, определение тональности, заведение обращений при негативе")
    Container($ID_MESSAGE_BROKER, "Брокер сообщений", "RabbitMQ", "Очереди reviews.labeling (задачи разметки) и cases.events (события по обращениям)")
    Container($ID_BACKGROUND_WORKER, "Воркер фоновых задач", "Python / Celery beat", "Сбор отзывов по расписанию, контроль сроков, эскалации, рассылка уведомлений")
    ContainerDb($ID_DATABASE, "База данных", "PostgreSQL 16", "Отзывы, разметка, обращения, история статусов, справочники, витрины аналитики")
    ContainerDb($ID_CACHE, "Кэш", "Redis", "Предрассчитанные агрегаты дашборда")
}

Rel($ID_CX_ANALYST, $ID_WEB_PANEL, "Загружает пакеты отзывов, изучает дашборд, формирует отчёты", "HTTPS")
Rel($ID_ADMIN, $ID_WEB_PANEL, "Настраивает темы, владельцев и сроки реакции", "HTTPS")
Rel($ID_PRODUCT_OWNER, $ID_WEB_PANEL, "Берёт обращения своего направления в работу", "HTTPS")
Rel($ID_PRODUCT_OWNER, $ID_MOBILE_APP, "Меняет статусы обращений вне рабочего места", "HTTPS")
Rel($ID_HEAD_OF_DIRECTION, $ID_MOBILE_APP, "Просматривает эскалации и просроченные обращения", "HTTPS")
Rel($ID_WEB_PANEL, $ID_BANK_IAM, "Перенаправляет пользователя на страницу единого входа", "HTTPS / OAuth 2.0 (OIDC)")
Rel($ID_MOBILE_APP, $ID_BANK_IAM, "Перенаправляет пользователя на страницу единого входа", "HTTPS / OAuth 2.0 (OIDC)")
Rel($ID_WEB_PANEL, $ID_API_BACKEND, "Запрашивает отзывы, обращения, аналитику и справочники", "HTTPS / JSON, REST")
Rel($ID_MOBILE_APP, $ID_API_BACKEND, "Запрашивает обращения и передаёт смену статуса", "HTTPS / JSON, REST")
Rel($ID_API_BACKEND, $ID_BANK_IAM, "Проверяет подлинность и роли сотрудников", "HTTPS / OAuth 2.0 (OIDC)")
Rel($ID_API_BACKEND, $ID_DATABASE, "Сохраняет и получает отзывы, обращения, историю статусов и справочники", "SQL / TCP")
Rel($ID_API_BACKEND, $ID_CACHE, "Получает и обновляет агрегаты дашборда", "RESP / TCP")
Rel($ID_API_BACKEND, $ID_MESSAGE_BROKER, "Ставит задачи разметки для загруженного пакета отзывов", "AMQP")
Rel($ID_API_BACKEND, $ID_REPORTING_SYSTEM, "Выгружает отчёты за период", "HTTPS / REST, JSON")
Rel($ID_LABELING_WORKER, $ID_MESSAGE_BROKER, "Забирает задачи разметки из очереди reviews.labeling", "AMQP")
Rel($ID_LABELING_WORKER, $ID_DATABASE, "Получает текст отзыва и справочник тем", "SQL / TCP")
Rel($ID_LABELING_WORKER, $ID_DATABASE, "Сохраняет результаты разметки", "SQL / TCP")
Rel($ID_LABELING_WORKER, $ID_DATABASE, "Заводит обращение при негативе по значимой теме", "SQL / TCP")
Rel($ID_LABELING_WORKER, $ID_MESSAGE_BROKER, "Публикует событие «обращение создано» в очередь cases.events", "AMQP")
Rel($ID_BACKGROUND_WORKER, $ID_REVIEW_SOURCE, "Забирает новые отзывы по расписанию", "HTTPS / REST, JSON")
Rel($ID_BACKGROUND_WORKER, $ID_MESSAGE_BROKER, "Ставит задачи разметки для полученных отзывов", "AMQP")
Rel($ID_BACKGROUND_WORKER, $ID_MESSAGE_BROKER, "Забирает события по обращениям из очереди cases.events", "AMQP")
Rel($ID_BACKGROUND_WORKER, $ID_DATABASE, "Сохраняет отзывы, полученные из источника", "SQL / TCP")
Rel($ID_BACKGROUND_WORKER, $ID_DATABASE, "Назначает обращению владельца и срок реакции", "SQL / TCP")
Rel($ID_BACKGROUND_WORKER, $ID_DATABASE, "Проверяет сроки обращений", "SQL / TCP")
Rel($ID_BACKGROUND_WORKER, $ID_DATABASE, "Фиксирует эскалацию просроченного обращения", "SQL / TCP")
Rel($ID_BACKGROUND_WORKER, $ID_NOTIFY_SERVICE, "Передаёт уведомления о новых обращениях и эскалациях", "SMTP / TLS, HTTPS")
Rel($ID_NOTIFY_SERVICE, $ID_MOBILE_APP, "Доставляет push-уведомления об обращениях и эскалациях", "APNs / FCM")
Rel($ID_NOTIFY_SERVICE, $ID_PRODUCT_OWNER, "Сообщает о новом обращении по направлению", "SMTP / TLS")
Rel($ID_NOTIFY_SERVICE, $ID_HEAD_OF_DIRECTION, "Сообщает о просрочке и эскалации", "SMTP / TLS")

@enduml
