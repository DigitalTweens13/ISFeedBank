@startuml "dynamic_process.puml"
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!include main.puml

' ГЛОССАРИЙ ID: см. context_l1.puml тимлида (единый для всей команды, менять только через ТЛ)
' Правила: только Rel(); без Rel_D/R/L/U; описания элементов дословно из общих диаграмм.
' Нумерация шагов сквозная и совпадает с общей диаграммой dynamic_process.puml.

LAYOUT_WITH_LEGEND()

title Динамическая диаграмма. Сквозной процесс: от загрузки отзывов до реакции владельца и эскалации просрочки

Person($ID_CX_ANALYST, "Аналитик клиентского опыта", "Загружает отзывы, анализирует настроения клиентов, формирует отчёты")
System_Ext($ID_BANK_IAM, "Система управления доступом банка", "Единый вход и ролевая модель сотрудников банка")
System_Ext($ID_NOTIFY_SERVICE, "Сервис уведомлений", "Почтовый сервер банка и push-сервисы APNs / FCM")
Person($ID_PRODUCT_OWNER, "Владелец продукта", "Отвечает за обращения по своему продуктовому направлению: ипотека, карты, приложение, отделения")
System_Ext($ID_REVIEW_SOURCE, "Источник отзывов", "Агрегатор отзывов о банках с программным интерфейсом выгрузки")
Person($ID_HEAD_OF_DIRECTION, "Руководитель направления", "Контролирует сроки реакции на обращения, получает эскалации")
System_Boundary($ID_FEEDBACK_SYSTEM, "ИС управления обратной связью клиентов банка") {
    Container($ID_WEB_PANEL, "Веб-панель", "React / TypeScript, SPA", "Дашборд настроений, реестры отзывов и обращений, справочники, отчёты")
    Container($ID_API_BACKEND, "Backend API", "Python / FastAPI, JWT", "REST API, проверка доступа, статусная модель обращений, назначение владельцев, отчёты")
    ContainerDb($ID_DATABASE, "База данных", "PostgreSQL 16", "Отзывы, разметка, обращения, история статусов, справочники, витрины аналитики")
    Container($ID_MESSAGE_BROKER, "Брокер сообщений", "RabbitMQ", "Очереди reviews.labeling (задачи разметки) и cases.events (события по обращениям)")
    Container($ID_LABELING_WORKER, "Воркер разметки", "Python / Celery", "Кластеризация, мультилейбл-классификация тем, определение тональности, заведение обращений при негативе")
    Container($ID_BACKGROUND_WORKER, "Воркер фоновых задач", "Python / Celery beat", "Сбор отзывов по расписанию, контроль сроков, эскалации, рассылка уведомлений")
    Container($ID_MOBILE_APP, "Мобильное приложение", "TypeScript / React Native, iOS / Android", "Обращения и эскалации для владельцев продуктов и руководителей, смена статусов вне рабочего места")
    ContainerDb($ID_CACHE, "Кэш", "Redis", "Предрассчитанные агрегаты дашборда")
}

' --- А. Загрузка пакета и разметка отзывов (аналитик, Backend API, брокер, воркер разметки) ---
Rel($ID_CX_ANALYST, $ID_WEB_PANEL, "1. Выбирает файл с пакетом отзывов и запускает загрузку", "HTTPS")
Rel($ID_WEB_PANEL, $ID_API_BACKEND, "2. Отправляет пакет отзывов (POST /feedback/batches) с токеном сессии", "HTTPS / JSON, REST")
Rel($ID_API_BACKEND, $ID_BANK_IAM, "3. Проверяет подпись токена по открытым ключам и получает роли сотрудника", "HTTPS / OAuth 2.0 (OIDC)")
Rel($ID_API_BACKEND, $ID_DATABASE, "4. Обезличивает, отсеивает дубли и сохраняет принятые отзывы", "SQL / TCP")
Rel($ID_API_BACKEND, $ID_MESSAGE_BROKER, "5. Ставит задачу разметки на каждый принятый отзыв в очередь reviews.labeling", "AMQP")
Rel($ID_LABELING_WORKER, $ID_MESSAGE_BROKER, "6. Забирает задачу разметки из очереди reviews.labeling", "AMQP")
Rel($ID_LABELING_WORKER, $ID_DATABASE, "7. Получает текст отзыва и справочник тем", "SQL / TCP")
Rel($ID_LABELING_WORKER, $ID_DATABASE, "8. Сохраняет темы и тональность отзыва", "SQL / TCP")
Rel($ID_LABELING_WORKER, $ID_DATABASE, "9. Заводит обращение при негативе по значимой теме", "SQL / TCP")
Rel($ID_LABELING_WORKER, $ID_MESSAGE_BROKER, "10. Публикует событие case_created в очередь cases.events и подтверждает задачу", "AMQP")
' --- Б. Назначение владельца и уведомление (воркер фоновых задач) ---
Rel($ID_BACKGROUND_WORKER, $ID_MESSAGE_BROKER, "11. Забирает событие case_created из очереди cases.events", "AMQP")
Rel($ID_BACKGROUND_WORKER, $ID_DATABASE, "12. Назначает обращению владельца и срок реакции", "SQL / TCP")
Rel($ID_BACKGROUND_WORKER, $ID_NOTIFY_SERVICE, "13. Передаёт уведомление о новом обращении владельцу продукта", "SMTP / TLS, HTTPS")
Rel($ID_NOTIFY_SERVICE, $ID_MOBILE_APP, "14. Доставляет push-уведомление о новом обращении", "APNs / FCM")
' --- В. Работа владельца в мобильном приложении ---
Rel($ID_PRODUCT_OWNER, $ID_MOBILE_APP, "15. Открывает обращение из уведомления", "HTTPS")
Rel($ID_MOBILE_APP, $ID_API_BACKEND, "16. Запрашивает карточку обращения (GET /cases/{case_id})", "HTTPS / JSON, REST")
Rel($ID_API_BACKEND, $ID_DATABASE, "17. Читает обращение и историю статусов", "SQL / TCP")
Rel($ID_MOBILE_APP, $ID_API_BACKEND, "18. Передаёт смену статуса на «в работе» (PATCH /cases/{case_id}/status)", "HTTPS / JSON, REST")
Rel($ID_API_BACKEND, $ID_DATABASE, "19. Проверяет допустимость перехода и записывает новый статус", "SQL / TCP")
Rel($ID_API_BACKEND, $ID_CACHE, "20. Сбрасывает устаревшие агрегаты дашборда", "RESP / TCP")
' --- Г. Фоновые процессы: сбор отзывов по расписанию, контроль сроков, эскалация, обращение руководителя ---
Rel($ID_BACKGROUND_WORKER, $ID_REVIEW_SOURCE, "21. Забирает новые отзывы по расписанию", "HTTPS / REST, JSON")
Rel($ID_BACKGROUND_WORKER, $ID_DATABASE, "22. Сохраняет отзывы, полученные из источника", "SQL / TCP")
Rel($ID_BACKGROUND_WORKER, $ID_MESSAGE_BROKER, "23. Ставит задачи разметки для полученных отзывов в очередь reviews.labeling", "AMQP")
Rel($ID_BACKGROUND_WORKER, $ID_DATABASE, "24. Проверяет сроки обращений (раз в минуту)", "SQL / TCP")
Rel($ID_BACKGROUND_WORKER, $ID_DATABASE, "25. Фиксирует эскалацию просроченного обращения", "SQL / TCP")
Rel($ID_BACKGROUND_WORKER, $ID_NOTIFY_SERVICE, "26. Передаёт руководителю направления уведомление об эскалации", "SMTP / TLS, HTTPS")
Rel($ID_NOTIFY_SERVICE, $ID_HEAD_OF_DIRECTION, "27. Сообщает о просрочке и эскалации", "SMTP / TLS")
Rel($ID_HEAD_OF_DIRECTION, $ID_MOBILE_APP, "28. Просматривает эскалации и просроченные обращения", "HTTPS")
Rel($ID_MOBILE_APP, $ID_API_BACKEND, "29. Запрашивает эскалированные обращения направления (GET /cases)", "HTTPS / JSON, REST")
Rel($ID_API_BACKEND, $ID_DATABASE, "30. Читает эскалированные обращения направления", "SQL / TCP")
@enduml
